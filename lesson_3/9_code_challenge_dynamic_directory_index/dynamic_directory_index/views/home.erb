<!DOCTYPE html>
<head>
  <meta charset="utf-8">
  <title>A Dynamic Directory</title>
</head>
<body>
  <ul>
    <% @files.each do |file| %>
    <%   file_name = file.split('/')[1] %>
    <li><a href="/<%= file_name %>"><%= file_name %></a></li>
    <% end %>
  </ul>
  <a href="/<%= "#{@sorting_is_descending ? '' : '?order=descending' }" %>">
    Sort in <%= (@sorting_is_descending ? 'ascending' : 'descending') %> order
  </a>
</body>